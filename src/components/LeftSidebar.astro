---
import { getPublishedPosts, readingTime } from '../utils/posts';
import FormattedDate from './FormattedDate.astro';

const allPosts = await getPublishedPosts();
// Top 4 popular/flagship posts
const posts = allPosts.slice(0, 4);

const tagColorMap: Record<string, string> = {
  aeo: 'var(--cat-aeo)',
  geo: 'var(--cat-geo)',
  'ai-search': 'var(--cat-ai-search)',
  rag: 'var(--cat-rag)',
  citations: 'var(--cat-citations)',
  guides: 'var(--cat-guides)',
  announcements: 'var(--cat-announcements)',
  'robots-txt': 'var(--cat-robots-txt)',
  seo: 'var(--cat-seo)',
};
---

<aside class="sidebar sidebar-left">
  <span class="sidebar-badge">Popular</span>
  <ul class="sidebar-links popular-list">
    {posts.map((p) => {
      const firstTag = p.data.tags?.[0];
      const dotColor = firstTag ? (tagColorMap[firstTag] || 'var(--accent)') : 'var(--accent)';
      const minutes = readingTime(p.body);
      return (
        <li class="popular-item">
          <a class="popular-link" href={`/blog/${p.slug}/`}>
            <span class="popular-title">{p.data.title}</span>
            <div class="popular-meta">
              <span class="popular-dot" style={`background: ${dotColor};`}></span>
              <FormattedDate date={p.data.pubDate} />
              <span aria-hidden="true">·</span>
              <span>{minutes}m read</span>
            </div>
          </a>
        </li>
      );
    })}
  </ul>
  <a class="sidebar-view-all" href="/tags/">View All Topics →</a>
</aside>

<style>
  .popular-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 0;
    margin: 0.75rem 0 1rem;
    list-style: none;
  }

  .popular-item {
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .popular-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .popular-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-decoration: none;
  }

  .popular-title {
    font-size: 0.84rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--text);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.15s;
  }

  .popular-link:hover .popular-title {
    color: var(--accent);
  }

  .popular-meta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    color: var(--text-faint);
  }

  .popular-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    display: inline-block;
  }
</style>
