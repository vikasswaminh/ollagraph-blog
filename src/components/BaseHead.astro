---
import { SITE } from '../config';

interface Props {
  title: string;
  description?: string;
  image?: string;
  metaTitle?: string;
  metaDescription?: string;
  primaryKeyword?: string;
  secondaryKeywords?: string | string[];
  keywords?: string | string[];
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    tags?: string[];
  };
  jsonLd?: Record<string, any>;
}

const {
  title,
  description = SITE.description,
  image,
  metaTitle,
  metaDescription,
  primaryKeyword,
  secondaryKeywords,
  keywords,
  article,
  jsonLd,
} = Astro.props;

const pathname = Astro.url.pathname;
const cleanPath = pathname === '/' || pathname.endsWith('/') ? pathname : `${pathname}/`;
const canonical = new URL(cleanPath, Astro.site).href;
const ogImage = image ? new URL(image, Astro.site).href : undefined;

// Determine final title
const activeTitle = metaTitle || title;
const fullTitle = activeTitle === SITE.title ? activeTitle : `${activeTitle} · ${SITE.brand} Blog`;

// Determine final description
const activeDescription = metaDescription || description;

// Format keyword strings with resilient fallback
const props = Astro.props as Record<string, any>;
const primaryKw = primaryKeyword || props['primary-keyword'] || props.primary_keyword || props['Primary SEO Keyword'] || props['Primary SEO Keywords'];
const secondaryKw = secondaryKeywords || props['secondary-keywords'] || props.secondary_keywords || props['Secondary SEO Keyword'] || props['Secondary SEO Keywords'] || props['SEO Keywords'] || keywords;

const secondaryKeywordsStr = secondaryKw
  ? Array.isArray(secondaryKw)
    ? secondaryKw.join(', ')
    : secondaryKw
  : '';
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#ffffff" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="canonical" href={canonical} />
<meta name="generator" content={Astro.generator} />

<!-- Google Fonts — Inter (non-render-blocking) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="preload"
  as="style"
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
/>
<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
  rel="stylesheet"
  media="print"
  onload="this.media='all'"
/>
<noscript>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
    rel="stylesheet"
  />
</noscript>

<title>{fullTitle}</title>
<meta name="description" content={activeDescription} />

{primaryKw && <meta name="primary-keyword" content={primaryKw} />}
{secondaryKeywordsStr && <meta name="secondary-keywords" content={secondaryKeywordsStr} />}

<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={activeDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={`${SITE.brand} Blog`} />
{ogImage && <meta property="og:image" content={ogImage} />}

<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={activeDescription} />
{ogImage && <meta name="twitter:image" content={ogImage} />}

{
  article && (
    <>
      {article.publishedTime && (
        <meta property="article:published_time" content={article.publishedTime} />
      )}
      {article.modifiedTime && (
        <meta property="article:modified_time" content={article.modifiedTime} />
      )}
      {article.author && <meta property="article:author" content={article.author} />}
      {article.tags &&
        article.tags.map((t) => <meta property="article:tag" content={t} />)}
    </>
  )
}

<link rel="sitemap" href="/sitemap-index.xml" />
{jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>}
