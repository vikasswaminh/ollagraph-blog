---
import { SITE } from '../config';

interface Props {
  title: string;
  description?: string;
  image?: string;
  metaTitle?: string;
  metaDescription?: string;
  primaryKeyword?: string;
  secondaryKeywords?: string | string[];
  keywords?: string | string[];
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    tags?: string[];
  };
  jsonLd?: Record<string, any>;
}

const {
  title,
  description = SITE.description,
  image,
  metaTitle,
  metaDescription,
  primaryKeyword,
  secondaryKeywords,
  keywords,
  article,
  jsonLd,
} = Astro.props;

const pathname = Astro.url.pathname;
const cleanPath = pathname === '/' || pathname.endsWith('/') ? pathname : `${pathname}/`;
const canonical = new URL(cleanPath, Astro.site).href;
const ogImage = image ? new URL(image, Astro.site).href : undefined;

// Determine final title without duplicate branding
const brandSuffix = ` · ${SITE.brand} Blog`;
let rawTitle = (metaTitle || title || SITE.title).trim();

// Strip any existing trailing brand references to prevent duplicate branding
rawTitle = rawTitle
  .replace(/\s*[·|—\-]\s*OllaGraph\s+Blog$/i, '')
  .replace(/\s*[·|—\-]\s*OllaGraph$/i, '')
  .trim();

const fullTitle = rawTitle === SITE.title || rawTitle === `${SITE.brand} Blog` || rawTitle === SITE.brand
  ? SITE.title
  : `${rawTitle}${brandSuffix}`;

// Determine final description
const activeDescription = metaDescription || description;

// Global Structured Data
const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: `${SITE.brand} Blog`,
  url: Astro.site ? new URL('/', Astro.site).href : SITE.url,
};

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.brand,
  url: SITE.marketingUrl,
};

// Format keyword strings with resilient fallback
const props = Astro.props as Record<string, any>;
const primaryKw = primaryKeyword || props['primary-keyword'] || props.primary_keyword || props['Primary SEO Keyword'] || props['Primary SEO Keywords'];
const secondaryKw = secondaryKeywords || props['secondary-keywords'] || props.secondary_keywords || props['Secondary SEO Keyword'] || props['Secondary SEO Keywords'] || props['SEO Keywords'] || keywords;

const secondaryKeywordsStr = secondaryKw
  ? Array.isArray(secondaryKw)
    ? secondaryKw.join(', ')
    : secondaryKw
  : '';
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#ffffff" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="canonical" href={canonical} />
<meta name="generator" content={Astro.generator} />

<!-- Self-Hosted Inter Variable Font (Zero External DNS Latency) -->
<link
  rel="preload"
  href="/fonts/inter-latin.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>

<title>{fullTitle}</title>
<meta name="description" content={activeDescription} />

{primaryKw && <meta name="primary-keyword" content={primaryKw} />}
{secondaryKeywordsStr && <meta name="secondary-keywords" content={secondaryKeywordsStr} />}

<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={activeDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={`${SITE.brand} Blog`} />
{ogImage && <meta property="og:image" content={ogImage} />}

<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={activeDescription} />
{ogImage && <meta name="twitter:image" content={ogImage} />}

{
  article && (
    <>
      {article.publishedTime && (
        <meta property="article:published_time" content={article.publishedTime} />
      )}
      {article.modifiedTime && (
        <meta property="article:modified_time" content={article.modifiedTime} />
      )}
      {article.author && <meta property="article:author" content={article.author} />}
      {article.tags &&
        article.tags.map((t) => <meta property="article:tag" content={t} />)}
    </>
  )
}

<link rel="sitemap" href="/sitemap-index.xml" />
<script is:inline type="application/ld+json" set:html={JSON.stringify(siteSchema)}></script>
<script is:inline type="application/ld+json" set:html={JSON.stringify(orgSchema)}></script>
{jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>}
