---
import { SITE } from '../config';

interface Props {
  title: string;
  description?: string;
  image?: string;
  metaTitle?: string;
  metaDescription?: string;
  primaryKeyword?: string;
  secondaryKeywords?: string | string[];
  keywords?: string | string[];
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    tags?: string[];
  };
  jsonLd?: Record<string, any>;
}

const {
  title,
  description = SITE.description,
  image,
  metaTitle,
  metaDescription,
  primaryKeyword,
  secondaryKeywords,
  keywords,
  article,
  jsonLd,
} = Astro.props;

const pathname = Astro.url.pathname;
const cleanPath = pathname === '/' || pathname.endsWith('/') ? pathname : `${pathname}/`;
const canonical = new URL(cleanPath, Astro.site).href;

// Ensure resilient fallback for Open Graph and Twitter card image (optimized WebP default)
const defaultOgImage = '/og-image.webp';
const activeImage = image || defaultOgImage;
const ogImage = new URL(activeImage, Astro.site).href;
const imageMimeType = ogImage.endsWith('.webp')
  ? 'image/webp'
  : ogImage.endsWith('.jpg') || ogImage.endsWith('.jpeg')
    ? 'image/jpeg'
    : 'image/png';

// Determine final title without duplicate branding (< 60 characters guaranteed)
const brandFullSuffix = ` · ${SITE.brand} Blog`;
const brandShortSuffix = ` · ${SITE.brand}`;
let rawTitle = (metaTitle || title || SITE.title).trim();

// Strip any existing trailing brand references to prevent duplicate branding
rawTitle = rawTitle
  .replace(/\s*[·|—\-]\s*OllaGraph\s+Blog$/i, '')
  .replace(/\s*[·|—\-]\s*OllaGraph$/i, '')
  .trim();

let fullTitle = '';
if (rawTitle === SITE.title || rawTitle === `${SITE.brand} Blog` || rawTitle === SITE.brand) {
  fullTitle = SITE.title.length < 60 ? SITE.title : SITE.title.slice(0, 54).replace(/\s+\S*$/, '') + '...';
} else if (rawTitle.length + brandFullSuffix.length <= 55) {
  fullTitle = `${rawTitle}${brandFullSuffix}`;
} else if (rawTitle.length + brandShortSuffix.length <= 55) {
  fullTitle = `${rawTitle}${brandShortSuffix}`;
} else if (rawTitle.length <= 55) {
  fullTitle = rawTitle;
} else {
  fullTitle = rawTitle.slice(0, 52).replace(/\s+\S*$/, '') + '...';
}

// Determine final description (< 160 characters guaranteed)
let activeDescription = (metaDescription || description || SITE.description).trim();
if (activeDescription.length >= 160) {
  activeDescription = activeDescription.slice(0, 156).replace(/\s+\S*$/, '') + '...';
}

// Global Structured Data
const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: `${SITE.brand} Blog`,
  description: activeDescription,
  url: Astro.site ? new URL('/', Astro.site).href : SITE.url,
};

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.brand,
  url: SITE.marketingUrl,
};

// Format keyword strings with resilient fallback
const props = Astro.props as Record<string, any>;
const primaryKw = primaryKeyword || props['primary-keyword'] || props.primary_keyword || props['Primary SEO Keyword'] || props['Primary SEO Keywords'];
const secondaryKw = secondaryKeywords || props['secondary-keywords'] || props.secondary_keywords || props['Secondary SEO Keyword'] || props['Secondary SEO Keywords'] || props['SEO Keywords'] || keywords;

const secondaryKeywordsStr = secondaryKw
  ? Array.isArray(secondaryKw)
    ? secondaryKw.join(', ')
    : secondaryKw
  : '';
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#ffffff" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="canonical" href={canonical} />
<meta name="generator" content={Astro.generator} />

<!-- Self-Hosted Inter Variable Font (Zero External DNS Latency) -->
<link
  rel="preload"
  href="/fonts/inter-latin.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>

<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={activeDescription} />

{primaryKw && <meta name="primary-keyword" content={primaryKw} />}
{secondaryKeywordsStr && <meta name="secondary-keywords" content={secondaryKeywordsStr} />}

<!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content={`${SITE.brand} Blog`} />
<meta property="og:locale" content="en_US" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={activeDescription} />
{ogImage && (
  <>
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content={imageMimeType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
  </>
)}

<!-- Twitter / X Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonical} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={activeDescription} />
{ogImage && (
  <>
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={fullTitle} />
  </>
)}

{
  article && (
    <>
      {article.publishedTime && (
        <meta property="article:published_time" content={article.publishedTime} />
      )}
      {article.modifiedTime && (
        <meta property="article:modified_time" content={article.modifiedTime} />
      )}
      {article.author && <meta property="article:author" content={article.author} />}
      {article.tags &&
        article.tags.map((t) => <meta property="article:tag" content={t} />)}
    </>
  )
}

<link rel="sitemap" href="/sitemap-index.xml" />
<script is:inline type="application/ld+json" set:html={JSON.stringify(siteSchema)}></script>
<script is:inline type="application/ld+json" set:html={JSON.stringify(orgSchema)}></script>
{jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>}
