---
interface Props {
  size?: number;
  class?: string;
}

const { size = 26, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 32 32"
  width={size}
  height={size}
  class:list={['brand-mark-svg', className]}
  aria-hidden="true"
>
  <line x1="6" y1="16" x2="16" y2="16" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
  <line x1="16" y1="16" x2="26" y2="7" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
  <line x1="16" y1="16" x2="26" y2="25" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
  <line x1="26" y1="7" x2="26" y2="25" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/>
  <circle cx="6" cy="16" r="3.5" fill="currentColor"/>
  <circle cx="16" cy="16" r="3" fill="currentColor"/>
  <circle cx="26" cy="7" r="3.5" fill="currentColor"/>
  <circle cx="26" cy="25" r="3.5" fill="currentColor"/>
</svg>
