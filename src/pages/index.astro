---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeftSidebar from '../components/LeftSidebar.astro';
import RightSidebar from '../components/RightSidebar.astro';
import PostCard from '../components/PostCard.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE } from '../config';
import { getPublishedPosts, readingTime } from '../utils/posts';

const posts = await getPublishedPosts();
const featured = posts[0];
const rest = posts.slice(1);

// Tag color mapping
const tagColorMap: Record<string, string> = {
  aeo: 'var(--cat-aeo)',
  geo: 'var(--cat-geo)',
  'ai-search': 'var(--cat-ai-search)',
  rag: 'var(--cat-rag)',
  citations: 'var(--cat-citations)',
  guides: 'var(--cat-guides)',
  announcements: 'var(--cat-announcements)',
  'robots-txt': 'var(--cat-robots-txt)',
  seo: 'var(--cat-seo)',
};

const tagDisplayNames: Record<string, string> = {
  aeo: 'AEO',
  geo: 'GEO',
  'ai-search': 'AI Search',
  rag: 'RAG',
  citations: 'Citations',
  guides: 'Guides',
  announcements: 'Announcements',
  'robots-txt': 'Robots.txt',
  seo: 'SEO',
};

const featuredTag = featured?.data.tags?.[0];
const featuredBadgeColor = featuredTag ? (tagColorMap[featuredTag] || 'var(--cat-guides)') : 'var(--cat-guides)';
const featuredBadgeLabel = featuredTag ? (tagDisplayNames[featuredTag] || featuredTag) : '';
---

<BaseLayout>
  <div class="page-grid">
    <LeftSidebar />

    <div class="main-content">
      <!-- Clean Hero Headline -->
      <section class="hero" style="margin-bottom: 1.25rem;">
        <h1 class="hero-title" style="font-size: clamp(2rem, 3.8vw, 2.5rem); font-weight: 800; letter-spacing: -0.03em; margin-bottom: 0.4rem; color: #111827;">
          {SITE.brand} Blog
        </h1>
        <p class="hero-subtitle" style="font-size: 0.98rem; color: #4B5563; max-width: 38rem;">
          {SITE.description}
        </p>
      </section>

      <!-- Newest Articles Pill Label -->
      <div class="newest-label" style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1.1rem;">
        <span class="newest-pill" style="background: #ea580c; color: #ffffff; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; padding: 0.28rem 0.75rem; border-radius: 999px;">
          ⚡ NEWEST ARTICLES
        </span>
        <span class="newest-sub" style="font-size: 0.84rem; color: #6B7280; font-weight: 500;">
          Latest from our experts
        </span>
      </div>

      {posts.length === 0 && <p class="empty">No posts yet — check back soon.</p>}

      <!-- Featured Post Card -->
      {featured && (
        <a class="featured-card-nh" href={`/blog/${featured.slug}/`}>
          <div class="featured-card-nh-top">
            {featuredTag && (
              <span class="badge" style={`background: ${featuredBadgeColor}; font-size: 0.72rem; padding: 0.2rem 0.65rem; border-radius: 4px;`}>
                {featuredBadgeLabel}
              </span>
            )}
            <span class="featured-nh-new">⚡ NEW</span>
          </div>

          <h2 class="featured-card-nh-title">{featured.data.title}</h2>
          <p class="featured-card-nh-desc">{featured.data.description}</p>

          <div class="featured-card-nh-footer">
            <div class="featured-card-nh-meta">
              <FormattedDate date={featured.data.pubDate} />
              <span class="sep" aria-hidden="true">·</span>
              <span>{readingTime(featured.body)} min read</span>
              {featured.data.author && <span class="sep" aria-hidden="true">·</span>}
              {featured.data.author && <span>By {featured.data.author}</span>}
            </div>
            <span class="featured-card-nh-cta">Read article →</span>
          </div>
        </a>
      )}

      <!-- Rest of Articles Grid -->
      {rest.length > 0 && (
        <section style="margin-top: 2rem;">
          <div class="post-grid">
            {rest.map((p) => (
              <PostCard
                url={`/blog/${p.slug}/`}
                title={p.data.title}
                description={p.data.description}
                pubDate={p.data.pubDate}
                tags={p.data.tags}
                minutes={readingTime(p.body)}
              />
            ))}
          </div>
        </section>
      )}
    </div>

    <RightSidebar />
  </div>
</BaseLayout>
