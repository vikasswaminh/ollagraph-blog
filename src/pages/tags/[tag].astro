---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeftSidebar from '../../components/LeftSidebar.astro';
import RightSidebar from '../../components/RightSidebar.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, readingTime } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = new Set<string>();
  for (const p of posts) for (const t of p.data.tags) tags.add(t);
  return [...tags].map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((p) => p.data.tags.includes(tag)), tag },
  }));
}

const { posts, tag } = Astro.props;

// Tag color mapping
const tagColorMap: Record<string, string> = {
  aeo: 'var(--cat-aeo)',
  geo: 'var(--cat-geo)',
  'ai-search': 'var(--cat-ai-search)',
  rag: 'var(--cat-rag)',
  citations: 'var(--cat-citations)',
  guides: 'var(--cat-guides)',
  announcements: 'var(--cat-announcements)',
  'robots-txt': 'var(--cat-robots-txt)',
  seo: 'var(--cat-seo)',
};

// Clean Human-Readable Display Names
const tagDisplayNames: Record<string, string> = {
  aeo: 'AEO',
  geo: 'GEO',
  'ai-search': 'AI Search',
  rag: 'RAG',
  citations: 'Citations',
  guides: 'Guides',
  announcements: 'Announcements',
  'robots-txt': 'Robots.txt',
  seo: 'SEO',
};

const label = tagDisplayNames[tag] || tag;
const badgeColor = tagColorMap[tag] || 'var(--cat-guides)';
---

<BaseLayout title={`${label} Articles`} description={`Explore all articles categorized under ${label} on the OllaGraph Blog.`}>
  <div class="page-grid">
    <LeftSidebar />

    <div class="main-content">
      <section class="hero" style="margin-bottom: 2rem;">
        <p class="post-eyebrow" style="margin-bottom: 0.75rem;">
          <a href="/tags/">← All Topics</a>
        </p>
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem; flex-wrap: wrap;">
          <span class="badge" style={`background: ${badgeColor}; font-size: 0.82rem; padding: 0.25rem 0.75rem;`}>
            {label}
          </span>
          <span style="font-size: 0.88rem; color: var(--text-muted); font-weight: 500;">
            {posts.length} {posts.length === 1 ? 'published article' : 'published articles'}
          </span>
        </div>
        <h1 class="hero-title" style="font-size: clamp(1.8rem, 3.5vw, 2.4rem); font-weight: 800; margin: 0.5rem 0 0.4rem;">
          Articles in {label}
        </h1>
        <p class="hero-subtitle">
          Showing all technical guides, benchmarks, and architectural analyses categorized under {label}.
        </p>
      </section>

      <div class="post-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        {
          posts.map((p) => (
            <PostCard
              url={`/blog/${p.slug}/`}
              title={p.data.title}
              description={p.data.description}
              pubDate={p.data.pubDate}
              tags={p.data.tags}
              minutes={readingTime(p.body)}
            />
          ))
        }
      </div>
    </div>

    <RightSidebar />
  </div>
</BaseLayout>
